# Fakturasjekk production/local environment template.
# Never commit real secret values. Fakturasjekk uses its own dedicated Supabase organization/project.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# Sponsor-wait / zero-cost guard.
# Keep this on zero until financing explicitly approves paid external services.
FAKTURASJEKK_COST_MODE=zero
FAKTURASJEKK_PAID_SERVICES_APPROVED=no
CUSTOMER_UPLOAD_ENABLED=false
PRODUCTION_API_ENABLED=false

# Dedicated Fakturasjekk Supabase project ONLY.
# Project ref and URL are public identifiers; secret/database credentials must stay server-side.
SUPABASE_PROJECT_REF=jxmkaxwflouacuboaetg
SUPABASE_URL=https://jxmkaxwflouacuboaetg.supabase.co
SUPABASE_PUBLISHABLE_KEY=SET_PUBLIC_PUBLISHABLE_KEY_WHEN_FRONTEND_AUTH_IS_ENABLED
# Server/runtime only – never expose in GitHub Pages/browser.
SUPABASE_SECRET_KEY=SET_ONLY_IN_SERVER_SECRET_STORE
# Use either the direct Fakturasjekk DB host or Supavisor with username postgres.jxmkaxwflouacuboaetg.
DATABASE_URL=postgresql://SET_ONLY_IN_SERVER_SECRET_STORE
PRIVATE_STORAGE_BUCKET=case-documents-private
AUTH_ISSUER=https://jxmkaxwflouacuboaetg.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated

# Separate Fakturasjekk Google Cloud project ONLY. Project ID is not a secret.
# These provider definitions may be prepared, but must not be activated while FAKTURASJEKK_COST_MODE=zero.
GOOGLE_CLOUD_PROJECT_ID=SET_AFTER_SEPARATE_FAKTURASJEKK_GOOGLE_PROJECT_EXISTS
GOOGLE_CLOUD_LOCATION=eu
GOOGLE_VISION_PROVIDER=google_cloud_vision
GOOGLE_STRUCTURED_AI_PROVIDER=google_vertex_ai
GOOGLE_STRUCTURED_AI_MODEL=gemini-3.1-flash-lite
# Fallback only if verified keyless workload identity is not available at launch.
# Entire service-account JSON is a server secret; never expose it to browser/GitHub Pages.
GOOGLE_SERVICE_ACCOUNT_JSON=SET_ONLY_IN_SERVER_SECRET_STORE

# Private malware scanning. The canonical run.app URL is public configuration, but the service must
# deny unauthenticated invocation. Fakturasjekk calls it with a Google-signed ID token.
MALWARE_SCANNER_PROVIDER=unset
MALWARE_SCANNER_CLOUD_RUN_URL=SET_AFTER_PRIVATE_FAKTURASJEKK_CLAMAV_SERVICE_EXISTS
MALWARE_SCANNER_MAX_FILE_BYTES=15728640

# Vipps ePayment – all real merchant credentials are server secrets.
# PAYMENT_PROVIDER must stay unset while zero-cost mode is active.
PAYMENT_PROVIDER=unset
VIPPS_ENVIRONMENT=test
VIPPS_MERCHANT_SERIAL_NUMBER=SET_ONLY_IN_SERVER_SECRET_STORE
VIPPS_CLIENT_ID=SET_ONLY_IN_SERVER_SECRET_STORE
VIPPS_CLIENT_SECRET=SET_ONLY_IN_SERVER_SECRET_STORE
VIPPS_SUBSCRIPTION_KEY=SET_ONLY_IN_SERVER_SECRET_STORE
VIPPS_WEBHOOK_SECRET=SET_ONLY_IN_SERVER_SECRET_STORE

# Free development substitutes: unset/manual/synthetic/local.
DOCUMENT_EXTRACTOR_PROVIDER=manual
RESPONSE_INTERPRETER_PROVIDER=synthetic
ENCRYPTION_KEY_ID=unset
