# Fakturasjekk production/local environment template.
# Never commit real values. Fakturasjekk must use its own dedicated Supabase organization/project.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# Dedicated Fakturasjekk Supabase project only
SUPABASE_URL=https://YOUR_FAKTURASJEKK_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_FAKTURASJEKK_PROJECT_REF
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server/runtime only – never expose in GitHub Pages/browser
SUPABASE_SECRET_KEY=SET_ONLY_IN_SERVER_SECRET_STORE
DATABASE_URL=postgresql://SET_ONLY_IN_SERVER_SECRET_STORE
PRIVATE_STORAGE_BUCKET=case-documents-private
AUTH_ISSUER=https://YOUR_FAKTURASJEKK_PROJECT_REF.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated

PAYMENT_PROVIDER=unset
DOCUMENT_EXTRACTOR_PROVIDER=unset
RESPONSE_INTERPRETER_PROVIDER=unset
ENCRYPTION_KEY_ID=unset
