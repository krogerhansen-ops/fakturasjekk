{
  "version": "0.67.0",
  "policy_status": "product_default_subject_to_final_dpia",
  "principle": "Store personal data only for as long as necessary for the stated purpose.",
  "modes": {
    "temporary": {
      "default": true,
      "source_documents_ttl_hours_after_completed_analysis": 24,
      "case_content_ttl_days_after_last_activity": 7,
      "description_no": "Standardvalg. Kildedokumenter slettes kort tid etter ferdig analyse. Midlertidig saksinnhold beholdes bare for å kunne levere resultatet og håndtere tekniske feil."
    },
    "saved_case": {
      "default": false,
      "requires_explicit_user_choice": true,
      "case_ttl_days_after_last_activity": 90,
      "renewal_requires_user_action": true,
      "description_no": "Brukeren velger uttrykkelig å lagre saken for oppfølging, leverandørsvar og svarrunde 2. Saken får automatisk utløpsdato som kan fornyes ved aktiv bruk."
    }
  },
  "security_audit": {
    "contains_document_content": false,
    "target_ttl_days": 90,
    "allowlist_only": true
  },
  "backup_requirements": {
    "provider_must_document_retention": true,
    "ordinary_rotating_backup_max_days_product_requirement": 35,
    "deletion_ledger_ttl_days": 45,
    "deletion_ledger_contains_only_case_id_and_deleted_at": true,
    "must_be_encrypted": true,
    "source_document_storage_is_not_part_of_standard_database_backup": true,
    "restore_must_reapply_deletion_ledger_before_user_access": true,
    "deleted_cases_must_not_be_reactivated_by_restore": true,
    "production_end_to_end_restore_test_required": true
  },
  "purge_behavior": {
    "delete_source_documents": true,
    "delete_extracted_personal_content": true,
    "delete_generated_drafts": true,
    "delete_supplier_responses": true,
    "delete_cached_case_content": true,
    "retain_only_data_required_by_separate_legal_obligation": true,
    "separate_payment_accounting_records_from_case_documents": true,
    "provider_side_deletion_required_where_supported": true
  },
  "user_controls": [
    "show_expiry_date",
    "delete_case_now",
    "switch_from_temporary_to_saved_case_before_expiry"
  ],
  "production_verification": [
    "database_delete_end_to_end",
    "object_storage_delete_end_to_end",
    "provider_artifact_delete_where_supported",
    "deletion_tombstone_written_before_case_purge",
    "backup_restore_does_not_resurrect_deleted_case",
    "deletion_tombstone_expires_after_backup_window",
    "audit_contains_only_minimal_delete_status"
  ],
  "sources": [
    "https://www.datatilsynet.no/rettigheter-og-plikter/personvernprinsippene/grunnleggende-personvernprinsipper/lagringsbegrensning/",
    "https://www.datatilsynet.no/rettigheter-og-plikter/den-registrertes-rettigheter/rett-til-sletting/"
  ]
}
